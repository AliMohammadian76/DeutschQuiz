# Copy to .env locally and replace the placeholder password.
POSTGRES_USER=deutschquiz
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=deutschquiz

# ASP.NET Core maps double underscores to nested configuration keys.
ConnectionStrings__DeutschQuiz=Host=localhost;Port=5432;Database=deutschquiz;Username=deutschquiz;Password=replace-with-a-local-password

# Generate a random value of at least 32 characters for local development.
Jwt__SigningKey=replace-with-a-random-secret-of-at-least-32-characters
Jwt__Issuer=DeutschQuiz.Api
Jwt__Audience=DeutschQuiz.Web
